{
  "name": "pcln-docs",
  "version": "1.1.0",
  "description": "NexaCL developer tutorials, task guides and versioned API reference",
  "main": "index.js",
  "scripts": {
    "docs:sync": "node scripts/sync-plugin-sdk-docs.mjs",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "deploy:cf": "pnpm docs:build && pnpm dlx wrangler@4 pages deploy .vitepress/dist --project-name=pcln-docs",
