      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "medium-zoom": "^1.1.0",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-i18n": "^1.3.5",
    "vue": "^3.5.35"
  }
}
